{
  "name": "sokopos",
  "main": "./dist-worker/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "build": {
    "command": "npm run build:worker"
  }
}
