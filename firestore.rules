rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions: Authentication, Validation, Super-Admin & Multi-Tenant RBAC
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string &&
             id.size() > 0 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_.\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'upfrontretaile@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.uid == 'ulGLrKgcsrWyqcGRJ6DzvHoEYY12' ||
        (request.auth.token.role != null && request.auth.token.role == 'super_admin')
      );
    }

    function tokenBusinessId() {
      return request.auth.token.businessId;
    }

    function isOwnerOf(bizId) {
      return bizId is string &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             exists(/databases/$(database)/documents/businesses/$(bizId)) &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerEmail is string &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerEmail.lower() == request.auth.token.email.lower();
    }

    function isMemberOf(bizId) {
      return bizId is string &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == bizId;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        isSuperAdmin()
      );
    }

    function hasTenantAccess(bizId) {
      return isEmailVerified() && (
        isSuperAdmin() ||
        (bizId != null && tokenBusinessId() != null && tokenBusinessId() == bizId) ||
        (bizId != null && isOwnerOf(bizId)) ||
        (bizId != null && isMemberOf(bizId))
      );
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint - Used on app boot to verify network connectivity
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }

    // Platform Settings & Login Branding
    match /platform_settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isSuperAdmin() && isValidId(settingId);
    }

    // Users Collection (Profile documents keyed by Firebase Auth UID; prevents self-escalation)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isEmailVerified() && isValidId(userId) && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          (!('role' in request.resource.data) || request.resource.data.role in ['business_owner', 'manager', 'cashier', 'supervisor', 'accountant']) &&
          (!('businessId' in request.resource.data) || (
            request.resource.data.businessId is string && (
              request.resource.data.businessId == 'biz-demo' ||
              isOwnerOf(request.resource.data.businessId) ||
              (tokenBusinessId() != null && tokenBusinessId() == request.resource.data.businessId)
            )
          ))
        )
      );
      allow update: if isEmailVerified() && isValidId(userId) && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          (!('role' in request.resource.data) || request.resource.data.role in ['business_owner', 'manager', 'cashier', 'supervisor', 'accountant']) &&
          (!('businessId' in request.resource.data) || (
            resource != null && request.resource.data.businessId == resource.data.businessId
          ) || isOwnerOf(request.resource.data.businessId))
        )
      );
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // Businesses Collection (Tenants - billing, status, and Paystack subaccount fields protected)
    match /businesses/{businessId} {
      allow get: if isSignedIn() && isValidId(businessId) && (
        isSuperAdmin() ||
        (resource != null && request.auth.token.email_verified == true && request.auth.token.email is string && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower()) ||
        hasTenantAccess(businessId)
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.email_verified == true && request.auth.token.email is string && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
      );
      allow create: if isEmailVerified() && isValidId(businessId) && (
        isSuperAdmin() ||
        (
          businessId != 'biz-demo' &&
          request.resource.data.id != 'biz-demo' &&
          request.auth.token.email is string &&
          request.resource.data.ownerEmail is string &&
          request.resource.data.ownerEmail.lower() == request.auth.token.email.lower() &&
          (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
          (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
          !('subscription' in request.resource.data) &&
          (!('paystackSubaccountStatus' in request.resource.data) || request.resource.data.paystackSubaccountStatus != 'verified')
        )
      );
      allow update: if isEmailVerified() && isValidId(businessId) && (
        isSuperAdmin() ||
        (
          (
            (resource != null && request.auth.token.email is string && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower()) ||
            hasTenantAccess(businessId)
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'plan',
            'status',
            'subscription',
            'referredByCode',
            'referredAt',
            'paystackSubaccountCode',
            'paystackSettlementBank',
            'paystackSettlementAccountMask',
            'paystackSubaccountStatus',
            'paystackSubaccountVerifiedAt',
            'paystackFeeBearer'
          ])
        )
      );
      allow delete: if isEmailVerified() && isValidId(businessId) && (
        isSuperAdmin() ||
        (
          businessId != 'biz-demo' &&
          resource != null &&
          request.auth.token.email is string &&
          resource.data.ownerEmail is string &&
          resource.data.ownerEmail.lower() == request.auth.token.email.lower()
        )
      );
    }

    // Products Collection (Tenant catalog items - strictly scoped by businessId)
    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(productId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(productId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(productId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Categories Collection (Tenant product categories)
    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Locations Collection (Tenant store branches & till registers)
    match /locations/{locationId} {
      allow get: if isSignedIn() && isValidId(locationId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(locationId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(locationId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(locationId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Cashiers / Staff Collection (Tenant cashiers & staff accounts)
    match /cashiers/{cashierId} {
      allow get: if isSignedIn() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );

      // Private Server-Only Credentials Subcollection:
      match /private/{docId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // Dedicated server-only staff credentials collection (server Admin/ADC writes only; zero client writes)
    match /staff_credentials/{credId} {
      allow get: if isSuperAdmin() && isValidId(credId);
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // Transactions Collection (Tenant checkout receipts & sales)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(transactionId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(transactionId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(transactionId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Customers Collection (Tenant customer credit & loyalty)
    match /customers/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(customerId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(customerId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(customerId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Suppliers Collection (Tenant vendor directory & purchasing)
    match /suppliers/{supplierId} {
      allow get: if isSignedIn() && isValidId(supplierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(supplierId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(supplierId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(supplierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Stock Transfers Collection (Inter-branch inventory movements)
    match /stock_transfers/{transferId} {
      allow get: if isSignedIn() && isValidId(transferId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(transferId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(transferId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(transferId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Sync Logs Collection (Tenant audit events & replication history)
    match /sync_logs/{syncLogId} {
      allow get: if isSignedIn() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Purged Sales Backups Collection (Tenant pre-reset snapshot archives)
    match /purged_sales_backups/{backupId} {
      allow get: if isSignedIn() && isValidId(backupId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo' && hasTenantAccess(resource.data.businessId))
      );
      allow create: if isEmailVerified() && isValidId(backupId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(backupId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(backupId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Affiliates Collection (Partner profiles - managed exclusively via authenticated backend & Super Admin)
    match /affiliates/{affiliateId} {
      allow get: if isSignedIn() && isValidId(affiliateId) && (isSuperAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.uid == request.auth.uid);
      allow write: if isSuperAdmin() && isValidId(affiliateId);
    }

    // Affiliate Commissions Ledger (Server/SuperAdmin credited only)
    match /affiliate_commissions/{commissionId} {
      allow get: if isSignedIn() && isValidId(commissionId) && (isSuperAdmin() || (resource != null && resource.data.affiliateUid == request.auth.uid));
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow write: if isSuperAdmin() && isValidId(commissionId);
    }

    // Affiliate Payout Requests (Managed via authenticated server endpoints & SuperAdmin)
    match /affiliate_payouts/{payoutId} {
      allow get: if isSignedIn() && isValidId(payoutId) && (isSuperAdmin() || (resource != null && resource.data.affiliateUid == request.auth.uid));
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow write: if isSuperAdmin() && isValidId(payoutId);
    }

    // Platform Traffic Daily Rollups (Super-Admin-only read/write oversight)
    function isValidDateKey(dateKey) {
      return dateKey is string &&
             dateKey.size() == 10 &&
             dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTrafficDaily(data) {
      return data.keys().hasAll(['id', 'dateKey', 'pageViews', 'uniqueSessions', 'updatedAt']) &&
             data.id is string &&
             data.id.size() <= 16 &&
             isValidDateKey(data.dateKey) &&
             data.pageViews is number && data.pageViews >= 0 &&
             data.uniqueSessions is number && data.uniqueSessions >= 0 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /platform_traffic_daily/{dateKey} {
      allow get: if isSuperAdmin() && isValidDateKey(dateKey);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidDateKey(dateKey) && isValidTrafficDaily(request.resource.data);
      allow delete: if isSuperAdmin() && isValidDateKey(dateKey);
    }

    // Platform Traffic Milestone Events (Super-Admin-only read/write oversight)
    function isValidTrafficEventId(eventId) {
      return eventId is string &&
             eventId.size() > 0 &&
             eventId.size() <= 128 &&
             eventId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTrafficEvent(data) {
      return data.keys().hasAll(['id', 'dateKey', 'timestamp', 'eventType', 'sessionId', 'deviceType']) &&
             isValidTrafficEventId(data.id) &&
             isValidDateKey(data.dateKey) &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.eventType is string && data.eventType.size() <= 64 &&
             data.sessionId is string && data.sessionId.size() <= 96 &&
             data.deviceType in ['mobile', 'tablet', 'desktop'];
    }

    match /platform_traffic_events/{eventId} {
      allow get: if isSuperAdmin() && isValidTrafficEventId(eventId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidTrafficEventId(eventId) && isValidTrafficEvent(request.resource.data);
      allow delete: if isSuperAdmin() && isValidTrafficEventId(eventId);
    }

    // Server-side Payment Gateway Records (Daraja STK & Paystack webhook/verify audit log)
    function isValidPaymentRecordId(recordId) {
      return recordId is string &&
             recordId.size() > 0 &&
             recordId.size() <= 128 &&
             recordId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /payment_records/{recordId} {
      allow get: if isSuperAdmin() && isValidPaymentRecordId(recordId);
      allow list: if isSuperAdmin();
      allow write: if false;
    }
  }
}
