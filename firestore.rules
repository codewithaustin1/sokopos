rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions: Authentication, Validation, Super-Admin & Multi-Tenant RBAC
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string &&
             id.size() > 0 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_.\\-]+$');
    }

    function hasTokenEmail() {
      return 'email' in request.auth.token && request.auth.token.email is string;
    }

    function isTokenEmailVerified() {
      return 'email_verified' in request.auth.token && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (isTokenEmailVerified() && hasTokenEmail() && request.auth.token.email.lower() == 'upfrontretaile@gmail.com') ||
        request.auth.uid == 'ulGLrKgcsrWyqcGRJ6DzvHoEYY12' ||
        ('role' in request.auth.token && request.auth.token.role == 'super_admin')
      );
    }

    function tokenBusinessId() {
      return ('businessId' in request.auth.token && request.auth.token.businessId is string)
        ? request.auth.token.businessId
        : null;
    }

    function isOwnerOf(bizId) {
      return bizId is string &&
             isTokenEmailVerified() &&
             hasTokenEmail() &&
             exists(/databases/$(database)/documents/businesses/$(bizId)) &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerEmail is string &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerEmail.lower() == request.auth.token.email.lower();
    }

    function isMemberOf(bizId) {
      return bizId is string &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == bizId;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        isTokenEmailVerified() ||
        isSuperAdmin()
      );
    }

    function hasTenantAccess(bizId) {
      return isEmailVerified() && bizId is string && bizId.size() > 0 && (
        isSuperAdmin() ||
        (tokenBusinessId() != null && tokenBusinessId() == bizId) ||
        isMemberOf(bizId) ||
        isOwnerOf(bizId)
      );
    }

    // List-safe tenant guard: avoids resource-dependent get()/exists() on businesses/$(resource.data.businessId)
    function hasTenantListAccess(bizId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          isEmailVerified() &&
          bizId is string &&
          bizId.size() > 0 &&
          bizId != 'biz-demo' &&
          (
            (tokenBusinessId() != null && tokenBusinessId() == bizId) ||
            isMemberOf(bizId)
          )
        )
      );
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint - Used on app boot to verify network connectivity
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }

    // Platform Settings & Login Branding
    match /platform_settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isSuperAdmin() && isValidId(settingId);
    }

    // Users Collection (Profile documents keyed by Firebase Auth UID; prevents self-escalation)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isEmailVerified() && isValidId(userId) && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          (!('role' in request.resource.data) || request.resource.data.role in ['business_owner', 'manager', 'cashier', 'supervisor', 'accountant', 'inventory_clerk', 'partner']) &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == null || (
            request.resource.data.businessId is string && (
              request.resource.data.businessId == 'biz-demo' ||
              isOwnerOf(request.resource.data.businessId) ||
              (tokenBusinessId() != null && tokenBusinessId() == request.resource.data.businessId)
            )
          ))
        )
      );
      allow update: if isEmailVerified() && isValidId(userId) && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          (!('role' in request.resource.data) || request.resource.data.role in ['business_owner', 'manager', 'cashier', 'supervisor', 'accountant', 'inventory_clerk', 'partner']) &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == null || (
            resource != null && request.resource.data.businessId == resource.data.businessId
          ) || isOwnerOf(request.resource.data.businessId))
        )
      );
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    function isValidLegalConsent(lc) {
      return lc is map &&
        lc.keys().hasAll([
          'termsAccepted',
          'asIsWarrantyAcknowledged',
          'operationalRisksAccepted',
          'termsVersion',
          'entityName',
          'acceptedAt',
          'acceptedByEmail'
        ]) &&
        lc.keys().hasOnly([
          'termsAccepted',
          'asIsWarrantyAcknowledged',
          'operationalRisksAccepted',
          'termsVersion',
          'privacyPolicyVersion',
          'entityName',
          'acceptedAt',
          'acceptedByUid',
          'acceptedByEmail',
          'acceptedByName'
        ]) &&
        lc.termsAccepted == true &&
        lc.asIsWarrantyAcknowledged == true &&
        lc.operationalRisksAccepted == true &&
        lc.termsVersion is string && lc.termsVersion.size() > 0 && lc.termsVersion.size() <= 64 &&
        (!('privacyPolicyVersion' in lc) || (lc.privacyPolicyVersion is string && lc.privacyPolicyVersion.size() <= 64)) &&
        lc.entityName == 'Sokoplus Horizon' &&
        lc.acceptedAt is string && lc.acceptedAt.size() > 0 && lc.acceptedAt.size() <= 64 &&
        (!('acceptedByUid' in lc) || (lc.acceptedByUid is string && lc.acceptedByUid == request.auth.uid && lc.acceptedByUid.size() <= 128)) &&
        lc.acceptedByEmail is string && lc.acceptedByEmail.size() > 0 && lc.acceptedByEmail.size() <= 200 &&
        (!('acceptedByName' in lc) || (lc.acceptedByName is string && lc.acceptedByName.size() <= 160));
    }

    function isValidKraPinOrEmpty(val) {
      return val == null ||
             val == '' ||
             (val is string && val.size() == 11 && val.matches('^[AP][0-9]{9}[A-Z]$'));
    }

    function isOwnerOrBusinessOwnerRole(bizId) {
      return isSuperAdmin() ||
             isOwnerOf(bizId) ||
             (
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == bizId &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business_owner'
             );
    }

    function isValidBusinessTaxFields(data) {
      return (!('taxNumber' in data) || isValidKraPinOrEmpty(data.taxNumber)) &&
             (!('taxSettings' in data) || (
               data.taxSettings == null ||
               (
                 data.taxSettings is map &&
                 (!('taxNumber' in data.taxSettings) || isValidKraPinOrEmpty(data.taxSettings.taxNumber))
               )
             ));
    }

    function isValidTransactionEtimsPins(data) {
      return !('etimsData' in data) ||
             data.etimsData == null ||
             (
               data.etimsData is map &&
               (!('taxPin' in data.etimsData) || isValidKraPinOrEmpty(data.etimsData.taxPin)) &&
               (!('customerTin' in data.etimsData) || isValidKraPinOrEmpty(data.etimsData.customerTin))
             );
    }

    function isValidCustomer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 250)) &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500)) &&
             (!('kraPin' in data) || isValidKraPinOrEmpty(data.kraPin)) &&
             (!('isAnonymized' in data) || data.isAnonymized is bool);
    }

    function isValidSupplier(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
             (!('contactPerson' in data) || data.contactPerson == null || (data.contactPerson is string && data.contactPerson.size() <= 120)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 250)) &&
             (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 100)) &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500)) &&
             (!('kraPin' in data) || isValidKraPinOrEmpty(data.kraPin));
    }

    // Businesses Collection (Tenants - billing, status, taxNumber/taxSettings, and Paystack subaccount fields protected)
    match /businesses/{businessId} {
      allow get: if isSignedIn() && isValidId(businessId) && (
        isSuperAdmin() ||
        (resource != null && isTokenEmailVerified() && hasTokenEmail() && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower()) ||
        hasTenantAccess(businessId)
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (isTokenEmailVerified() && hasTokenEmail() && resource.data.ownerEmail == request.auth.token.email.lower())
      );
      allow create: if isEmailVerified() && isValidId(businessId) && (
        !('legalConsent' in request.resource.data) || isValidLegalConsent(request.resource.data.legalConsent)
      ) && isValidBusinessTaxFields(request.resource.data) && (
        isSuperAdmin() ||
        (
          businessId != 'biz-demo' &&
          request.resource.data.id != 'biz-demo' &&
          hasTokenEmail() &&
          request.resource.data.ownerEmail is string &&
          request.resource.data.ownerEmail.lower() == request.auth.token.email.lower() &&
          (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
          (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
          !('subscription' in request.resource.data) &&
          (!('paystackSubaccountStatus' in request.resource.data) || request.resource.data.paystackSubaccountStatus != 'verified')
        )
      );
      allow update: if isEmailVerified() && isValidId(businessId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['legalConsent']) ||
        ('legalConsent' in request.resource.data && isValidLegalConsent(request.resource.data.legalConsent))
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['taxNumber', 'taxSettings']) ||
        isValidBusinessTaxFields(request.resource.data)
      ) && (
        isSuperAdmin() ||
        (
          (
            (resource != null && hasTokenEmail() && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower()) ||
            hasTenantAccess(businessId)
          ) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['taxNumber', 'taxSettings']) || isOwnerOrBusinessOwnerRole(businessId)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'plan',
            'status',
            'subscription',
            'referredByCode',
            'referredAt',
            'paystackSubaccountCode',
            'paystackSettlementBank',
            'paystackSettlementAccountMask',
            'paystackSubaccountStatus',
            'paystackSubaccountVerifiedAt',
            'paystackFeeBearer'
          ])
        )
      );
      allow delete: if isEmailVerified() && isValidId(businessId) && (
        isSuperAdmin() ||
        (
          businessId != 'biz-demo' &&
          resource != null &&
          hasTokenEmail() &&
          resource.data.ownerEmail is string &&
          resource.data.ownerEmail.lower() == request.auth.token.email.lower()
        )
      );
    }

    // Products Collection (Tenant catalog items - strictly scoped by businessId)
    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(productId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(productId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(productId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Categories Collection (Tenant product categories)
    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(categoryId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Locations Collection (Tenant store branches & till registers)
    match /locations/{locationId} {
      allow get: if isSignedIn() && isValidId(locationId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(locationId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(locationId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(locationId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Cashiers / Staff Collection (Tenant cashiers & staff accounts)
    match /cashiers/{cashierId} {
      allow get: if isSignedIn() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(cashierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );

      // Private Server-Only Credentials Subcollection:
      match /private/{docId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // Dedicated server-only staff credentials collection (server Admin/ADC writes only; zero client writes)
    match /staff_credentials/{credId} {
      allow get: if isSuperAdmin() && isValidId(credId);
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // Transactions Collection (Tenant checkout receipts & sales)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(transactionId) &&
        isValidTransactionEtimsPins(request.resource.data) && (
          isSuperAdmin() ||
          (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
        );
      allow update: if isEmailVerified() && isValidId(transactionId) &&
        isValidTransactionEtimsPins(request.resource.data) && (
          isSuperAdmin() ||
          (
            resource != null &&
            resource.data.businessId is string &&
            hasTenantAccess(resource.data.businessId) &&
            request.resource.data.businessId == resource.data.businessId
          )
        );
      allow delete: if isEmailVerified() && isValidId(transactionId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Customers Collection (Tenant customer credit & loyalty)
    match /customers/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(customerId) &&
        isValidCustomer(request.resource.data) && (
          isSuperAdmin() ||
          (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
        );
      allow update: if isEmailVerified() && isValidId(customerId) &&
        isValidCustomer(request.resource.data) &&
        (!('isAnonymized' in resource.data) || resource.data.isAnonymized != true || isSuperAdmin() || (request.resource.data.isAnonymized == true && request.resource.data.name == 'Anonymized Customer')) && (
          isSuperAdmin() ||
          (
            resource != null &&
            resource.data.businessId is string &&
            hasTenantAccess(resource.data.businessId) &&
            request.resource.data.businessId == resource.data.businessId
          )
        );
      allow delete: if isEmailVerified() && isValidId(customerId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Suppliers Collection (Tenant vendor directory & purchasing)
    match /suppliers/{supplierId} {
      allow get: if isSignedIn() && isValidId(supplierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(supplierId) &&
        isValidSupplier(request.resource.data) && (
          isSuperAdmin() ||
          (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
        );
      allow update: if isEmailVerified() && isValidId(supplierId) &&
        isValidSupplier(request.resource.data) && (
          isSuperAdmin() ||
          (
            resource != null &&
            resource.data.businessId is string &&
            hasTenantAccess(resource.data.businessId) &&
            request.resource.data.businessId == resource.data.businessId
          )
        );
      allow delete: if isEmailVerified() && isValidId(supplierId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Stock Transfers Collection (Inter-branch inventory movements)
    match /stock_transfers/{transferId} {
      allow get: if isSignedIn() && isValidId(transferId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(transferId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(transferId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(transferId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Sync Logs Collection (Tenant audit events & replication history)
    match /sync_logs/{syncLogId} {
      allow get: if isSignedIn() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(syncLogId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Purged Sales Backups Collection (Tenant pre-reset snapshot archives)
    match /purged_sales_backups/{backupId} {
      allow get: if isSignedIn() && isValidId(backupId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(backupId) && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isEmailVerified() && isValidId(backupId) && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.businessId is string &&
          hasTenantAccess(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId
        )
      );
      allow delete: if isEmailVerified() && isValidId(backupId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    // Affiliates Collection (Partner profiles - managed exclusively via authenticated backend & Super Admin)
    match /affiliates/{affiliateId} {
      allow get: if isSignedIn() && isValidId(affiliateId) && (isSuperAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.uid == request.auth.uid);
      allow write: if isSuperAdmin() && isValidId(affiliateId);
    }

    // Affiliate Commissions Ledger (Server/SuperAdmin credited only)
    match /affiliate_commissions/{commissionId} {
      allow get: if isSignedIn() && isValidId(commissionId) && (isSuperAdmin() || (resource != null && resource.data.affiliateUid == request.auth.uid));
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow write: if isSuperAdmin() && isValidId(commissionId);
    }

    // Affiliate Payout Requests (Managed via authenticated server endpoints & SuperAdmin)
    match /affiliate_payouts/{payoutId} {
      allow get: if isSignedIn() && isValidId(payoutId) && (isSuperAdmin() || (resource != null && resource.data.affiliateUid == request.auth.uid));
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow write: if isSuperAdmin() && isValidId(payoutId);
    }

    // Platform Traffic Daily Rollups (Super-Admin-only read/write oversight)
    function isValidDateKey(dateKey) {
      return dateKey is string &&
             dateKey.size() == 10 &&
             dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidPeriodKey(periodKey) {
      return periodKey is string &&
             periodKey.size() == 7 &&
             periodKey.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidTrafficDaily(data) {
      return data.keys().hasAll(['id', 'dateKey', 'pageViews', 'uniqueSessions', 'updatedAt']) &&
             data.id is string &&
             data.id.size() <= 16 &&
             isValidDateKey(data.dateKey) &&
             data.pageViews is number && data.pageViews >= 0 &&
             data.uniqueSessions is number && data.uniqueSessions >= 0 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /platform_traffic_daily/{dateKey} {
      allow get: if isSuperAdmin() && isValidDateKey(dateKey);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidDateKey(dateKey) && isValidTrafficDaily(request.resource.data);
      allow delete: if isSuperAdmin() && isValidDateKey(dateKey);
    }

    // Platform Traffic Milestone Events (Super-Admin-only read/write oversight)
    function isValidTrafficEventId(eventId) {
      return eventId is string &&
             eventId.size() > 0 &&
             eventId.size() <= 128 &&
             eventId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTrafficEvent(data) {
      return data.keys().hasAll(['id', 'dateKey', 'timestamp', 'eventType', 'sessionId', 'deviceType']) &&
             isValidTrafficEventId(data.id) &&
             isValidDateKey(data.dateKey) &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.eventType is string && data.eventType.size() <= 64 &&
             data.sessionId is string && data.sessionId.size() <= 96 &&
             data.deviceType in ['mobile', 'tablet', 'desktop'];
    }

    match /platform_traffic_events/{eventId} {
      allow get: if isSuperAdmin() && isValidTrafficEventId(eventId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidTrafficEventId(eventId) && isValidTrafficEvent(request.resource.data);
      allow delete: if isSuperAdmin() && isValidTrafficEventId(eventId);
    }

    // Server-side Payment Gateway Records (Daraja STK & Paystack webhook/verify audit log)
    function isValidPaymentRecordId(recordId) {
      return recordId is string &&
             recordId.size() > 0 &&
             recordId.size() <= 128 &&
             recordId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAdminPaymentRecord(data, recordId) {
      return data.keys().hasAll(['reference', 'provider', 'status']) &&
             data.keys().hasOnly([
               'reference', 'provider', 'flowType', 'channel', 'amountKes', 'status',
               'businessId', 'planId', 'billingCycle', 'durationDays',
               'checkoutRequestId', 'merchantRequestId', 'mpesaReceiptNumber',
               'phone', 'customerEmail', 'ownerEmail', 'resultCode', 'pollAttempts',
               'resolvedBy', 'adminNote', 'reconciledByEmail', 'gatewayResponse',
               'authorizationUrl', 'paidAt', 'createdAt', 'updatedAt'
             ]) &&
             data.reference is string &&
             data.reference == recordId &&
             data.provider in ['paystack', 'daraja'] &&
             data.status in ['pending', 'pay_offline', 'success', 'failed', 'abandoned'] &&
             (!('flowType' in data) || data.flowType in ['subscription', 'pos_sale']) &&
             (!('channel' in data) || data.channel in ['mpesa_stk', 'card']) &&
             (!('amountKes' in data) || (data.amountKes is number && data.amountKes >= 0)) &&
             (!('businessId' in data) || (data.businessId is string && data.businessId.size() <= 128)) &&
             (!('planId' in data) || (data.planId is string && data.planId.size() <= 64)) &&
             (!('billingCycle' in data) || (data.billingCycle is string && data.billingCycle.size() <= 32)) &&
             (!('durationDays' in data) || (data.durationDays is number && data.durationDays >= 0)) &&
             (!('checkoutRequestId' in data) || (data.checkoutRequestId is string && data.checkoutRequestId.size() <= 128)) &&
             (!('merchantRequestId' in data) || (data.merchantRequestId is string && data.merchantRequestId.size() <= 128)) &&
             (!('mpesaReceiptNumber' in data) || (data.mpesaReceiptNumber is string && data.mpesaReceiptNumber.size() <= 64)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
             (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 160)) &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 160)) &&
             (!('resultCode' in data) || data.resultCode is number) &&
             (!('pollAttempts' in data) || (data.pollAttempts is number && data.pollAttempts >= 0)) &&
             (!('resolvedBy' in data) || (data.resolvedBy is string && data.resolvedBy.size() <= 64)) &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300)) &&
             (!('reconciledByEmail' in data) || (data.reconciledByEmail is string && data.reconciledByEmail.size() <= 160)) &&
             (!('gatewayResponse' in data) || (data.gatewayResponse is string && data.gatewayResponse.size() <= 256)) &&
             (!('authorizationUrl' in data) || (data.authorizationUrl is string && data.authorizationUrl.size() <= 512)) &&
             (!('paidAt' in data) || (data.paidAt is string && data.paidAt.size() <= 64)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /payment_records/{recordId} {
      allow get: if isValidPaymentRecordId(recordId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId)) ||
        (isEmailVerified() && hasTokenEmail() && resource != null && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
      );
      allow list: if isSuperAdmin() || (
        isEmailVerified() &&
        hasTokenEmail() &&
        resource.data.ownerEmail == request.auth.token.email.lower()
      );
      allow create, update: if isSuperAdmin() &&
        isValidPaymentRecordId(recordId) &&
        isValidAdminPaymentRecord(request.resource.data, recordId);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Tenant Business Intelligence Suite Collections (Rollups, Targets, Saved Views)
    // -------------------------------------------------------------------------
    function isValidAnalyticsRollup(data, docId) {
      return data.keys().hasAll([
               'id', 'businessId', 'locationId', 'locationName', 'dateKey',
               'grossSales', 'refundsTotal', 'discountsTotal', 'netSales', 'taxTotal',
               'cogsTotal', 'grossProfit', 'operatingExpenses', 'transactionCount', 'unitsSold',
               'mpesaTotal', 'cashTotal', 'cardTotal', 'storeCreditTotal', 'uncostedRevenue', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'businessId', 'locationId', 'locationName', 'dateKey',
               'grossSales', 'refundsTotal', 'discountsTotal', 'netSales', 'taxTotal',
               'cogsTotal', 'grossProfit', 'operatingExpenses', 'transactionCount', 'unitsSold',
               'mpesaTotal', 'cashTotal', 'cardTotal', 'storeCreditTotal', 'uncostedRevenue', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.id == docId &&
             isValidId(data.businessId) &&
             data.businessId != 'biz-demo' &&
             isValidId(data.locationId) &&
             data.locationName is string && data.locationName.size() > 0 && data.locationName.size() <= 160 &&
             isValidDateKey(data.dateKey) &&
             data.grossSales is number && data.grossSales >= 0 &&
             data.refundsTotal is number && data.refundsTotal >= 0 &&
             data.discountsTotal is number && data.discountsTotal >= 0 &&
             data.netSales is number && data.netSales >= 0 &&
             data.taxTotal is number && data.taxTotal >= 0 &&
             data.cogsTotal is number && data.cogsTotal >= 0 &&
             data.grossProfit is number &&
             data.operatingExpenses is number && data.operatingExpenses >= 0 &&
             data.transactionCount is number && data.transactionCount >= 0 &&
             data.unitsSold is number && data.unitsSold >= 0 &&
             data.mpesaTotal is number && data.mpesaTotal >= 0 &&
             data.cashTotal is number && data.cashTotal >= 0 &&
             data.cardTotal is number && data.cardTotal >= 0 &&
             data.storeCreditTotal is number && data.storeCreditTotal >= 0 &&
             data.uncostedRevenue is number && data.uncostedRevenue >= 0 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /analytics_daily_rollups/{rollupId} {
      allow get: if isSignedIn() && isValidId(rollupId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(rollupId) &&
        isValidAnalyticsRollup(request.resource.data, rollupId) && (
          isSuperAdmin() ||
          hasTenantAccess(request.resource.data.businessId)
        );
      allow update: if isEmailVerified() && isValidId(rollupId) &&
        isValidAnalyticsRollup(request.resource.data, rollupId) && (
          isSuperAdmin() ||
          (
            resource != null &&
            resource.data.businessId is string &&
            hasTenantAccess(resource.data.businessId) &&
            request.resource.data.businessId == resource.data.businessId
          )
        );
      allow delete: if isEmailVerified() && isValidId(rollupId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    function isValidAnalyticsTarget(data, docId) {
      return data.keys().hasAll([
               'id', 'businessId', 'locationId', 'periodKey',
               'revenueTarget', 'grossMarginTargetPct', 'maxDiscountPct', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'businessId', 'locationId', 'periodKey',
               'revenueTarget', 'grossMarginTargetPct', 'maxDiscountPct',
               'updatedAt', 'updatedByUid', 'updatedByEmail'
             ]) &&
             isValidId(data.id) &&
             data.id == docId &&
             isValidId(data.businessId) &&
             data.businessId != 'biz-demo' &&
             isValidId(data.locationId) &&
             isValidPeriodKey(data.periodKey) &&
             data.revenueTarget is number && data.revenueTarget >= 0 &&
             data.grossMarginTargetPct is number && data.grossMarginTargetPct >= 0 && data.grossMarginTargetPct <= 100 &&
             data.maxDiscountPct is number && data.maxDiscountPct >= 0 && data.maxDiscountPct <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid.size() <= 128)) &&
             (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.size() <= 160));
    }

    match /analytics_targets/{targetId} {
      allow get: if isSignedIn() && isValidId(targetId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(targetId) &&
        isValidAnalyticsTarget(request.resource.data, targetId) && (
          isSuperAdmin() ||
          hasTenantAccess(request.resource.data.businessId)
        );
      allow update: if isEmailVerified() && isValidId(targetId) &&
        isValidAnalyticsTarget(request.resource.data, targetId) && (
          isSuperAdmin() ||
          (
            resource != null &&
            resource.data.businessId is string &&
            hasTenantAccess(resource.data.businessId) &&
            request.resource.data.businessId == resource.data.businessId
          )
        );
      allow delete: if isEmailVerified() && isValidId(targetId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }

    function isValidAnalyticsSavedView(data, docId) {
      return data.keys().hasAll([
               'id', 'businessId', 'name', 'locationId', 'preset',
               'focusTab', 'chartMetric', 'isPinned', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'businessId', 'name', 'locationId', 'preset',
               'customStartIso', 'customEndIso', 'focusTab', 'chartMetric',
               'createdByUid', 'isPinned', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.id == docId &&
             isValidId(data.businessId) &&
             data.businessId != 'biz-demo' &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
             isValidId(data.locationId) &&
             data.preset in ['today', 'last_24h', 'last_7d', 'last_30d', 'last_90d', 'last_180d', 'last_1y', 'custom', 'all'] &&
             (!('customStartIso' in data) || (data.customStartIso is string && data.customStartIso.size() <= 64)) &&
             (!('customEndIso' in data) || (data.customEndIso is string && data.customEndIso.size() <= 64)) &&
             data.focusTab in ['sku_margin', 'category_pl', 'ledger'] &&
             data.chartMetric in ['net_sales', 'gross_profit', 'margin_pct', 'orders'] &&
             (!('createdByUid' in data) || (data.createdByUid is string && data.createdByUid.size() <= 128)) &&
             data.isPinned is bool &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /analytics_saved_views/{viewId} {
      allow get: if isSignedIn() && isValidId(viewId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
      allow list: if hasTenantListAccess(resource.data.businessId);
      allow create: if isEmailVerified() && isValidId(viewId) &&
        isValidAnalyticsSavedView(request.resource.data, viewId) && (
          isSuperAdmin() ||
          hasTenantAccess(request.resource.data.businessId)
        );
      allow update: if isEmailVerified() && isValidId(viewId) &&
        isValidAnalyticsSavedView(request.resource.data, viewId) && (
          isSuperAdmin() ||
          (
            resource != null &&
            resource.data.businessId is string &&
            hasTenantAccess(resource.data.businessId) &&
            request.resource.data.businessId == resource.data.businessId &&
            request.resource.data.createdAt == resource.data.createdAt
          )
        );
      allow delete: if isEmailVerified() && isValidId(viewId) && (
        isSuperAdmin() ||
        (resource != null && resource.data.businessId is string && hasTenantAccess(resource.data.businessId))
      );
    }
  }
}
