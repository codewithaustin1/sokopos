rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions: Authentication, Super-Admin & Multi-Tenant Access Control
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'upfrontretaile@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.uid == 'ulGLrKgcsrWyqcGRJ6DzvHoEYY12' ||
        (request.auth.token.role != null && request.auth.token.role == 'super_admin')
      );
    }

    function tokenBusinessId() {
      return request.auth.token.businessId;
    }

    function isOwnerOf(bizId) {
      return bizId is string &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             exists(/databases/$(database)/documents/businesses/$(bizId)) &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerEmail is string &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerEmail.lower() == request.auth.token.email.lower();
    }

    function isMemberOf(bizId) {
      return bizId is string &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == bizId;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        isSuperAdmin()
      );
    }

    function hasTenantAccess(bizId) {
      return isEmailVerified() && (
        isSuperAdmin() ||
        (bizId != null && tokenBusinessId() != null && tokenBusinessId() == bizId) ||
        (bizId != null && isOwnerOf(bizId)) ||
        (bizId != null && isMemberOf(bizId))
      );
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint - Used on app boot to verify network connectivity
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform Settings & Login Branding
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users Collection (Profile documents keyed by Firebase Auth UID)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isEmailVerified() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Businesses Collection (Tenants)
    match /businesses/{businessId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && request.auth.token.email_verified == true && request.auth.token.email is string && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower()) ||
        hasTenantAccess(businessId)
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.email_verified == true && resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email)
      );
      allow create: if isEmailVerified() && (
        isSuperAdmin() ||
        (request.resource.data.id != 'biz-demo' && request.auth.token.email is string && request.resource.data.ownerEmail is string && request.resource.data.ownerEmail.lower() == request.auth.token.email.lower())
      );
      allow update: if isEmailVerified() && (
        isSuperAdmin() ||
        (request.auth.token.email is string && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower()) ||
        (
          hasTenantAccess(businessId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'paystackSubaccountCode',
            'paystackSettlementBank',
            'paystackSettlementAccountMask',
            'paystackSubaccountStatus',
            'paystackSubaccountVerifiedAt',
            'paystackFeeBearer'
          ])
        )
      );
      allow delete: if isEmailVerified() && (
        isSuperAdmin() ||
        (request.auth.token.email is string && resource.data.ownerEmail is string && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
      );
    }

    // Products Collection (Tenant catalog items - Firestore single source of truth)
    match /products/{productId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Categories Collection (Tenant product categories)
    match /categories/{categoryId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Locations Collection (Tenant store branches & till registers)
    match /locations/{locationId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Cashiers / Staff Collection (Tenant cashiers & staff accounts)
    match /cashiers/{cashierId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );

      // Private Server-Only Credentials Subcollection:
      match /private/{docId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // Dedicated server-only staff credentials collection
    match /staff_credentials/{credId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() || (
        isEmailVerified() &&
        request.resource.data.businessId is string &&
        hasTenantAccess(request.resource.data.businessId)
      );
      allow update: if isSuperAdmin() || (
        isEmailVerified() &&
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
        (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
      );
      allow delete: if isSuperAdmin() || (
        isEmailVerified() &&
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Transactions Collection (Tenant checkout receipts & sales)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Customers Collection (Tenant customer credit & loyalty)
    match /customers/{customerId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Suppliers Collection (Tenant vendor directory & purchasing)
    match /suppliers/{supplierId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Stock Transfers Collection (Inter-branch inventory movements)
    match /stock_transfers/{transferId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Sync Logs Collection (Tenant audit events & replication history)
    match /sync_logs/{syncLogId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Purged Sales Backups Collection (Tenant pre-reset snapshot archives)
    match /purged_sales_backups/{backupId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)))
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.businessId is string && resource.data.businessId.size() > 0 && resource.data.businessId != 'biz-demo')
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && request.resource.data.businessId != 'biz-demo' && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Affiliates Collection (Partner profiles - PII and balances protected)
    match /affiliates/{affiliateId} {
      allow get: if isSignedIn() && (isSuperAdmin() || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isEmailVerified() && (
        isSuperAdmin() || (
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.totalEarnedKes == 0 &&
          request.resource.data.availableBalanceKes == 0 &&
          request.resource.data.paidOutKes == 0
        )
      );
      allow update: if isSuperAdmin() || (
        isEmailVerified() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mpesaPhone', 'name', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // Affiliate Commissions Ledger (Server/SuperAdmin credited only)
    match /affiliate_commissions/{commissionId} {
      allow get: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow write: if isSuperAdmin();
    }

    // Affiliate Payout Requests (Partner creates pending request; SuperAdmin approves/rejects)
    match /affiliate_payouts/{payoutId} {
      allow get: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow list: if isSignedIn() && (isSuperAdmin() || resource.data.affiliateUid == request.auth.uid);
      allow create: if isEmailVerified() && (
        isSuperAdmin() || (
          request.resource.data.affiliateUid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.amountKes >= 500
        )
      );
      allow update, delete: if isSuperAdmin();
    }

    // Platform Traffic Daily Rollups (Super-Admin-only read/write oversight)
    function isValidDateKey(dateKey) {
      return dateKey is string &&
             dateKey.size() == 10 &&
             dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTrafficDaily(data) {
      return data.keys().hasAll(['id', 'dateKey', 'pageViews', 'uniqueSessions', 'updatedAt']) &&
             data.id is string &&
             data.id.size() <= 16 &&
             isValidDateKey(data.dateKey) &&
             data.pageViews is number && data.pageViews >= 0 &&
             data.uniqueSessions is number && data.uniqueSessions >= 0 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /platform_traffic_daily/{dateKey} {
      allow get: if isSuperAdmin() && isValidDateKey(dateKey);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidDateKey(dateKey) && isValidTrafficDaily(request.resource.data);
      allow delete: if isSuperAdmin() && isValidDateKey(dateKey);
    }

    // Platform Traffic Milestone Events (Super-Admin-only read/write oversight)
    function isValidTrafficEventId(eventId) {
      return eventId is string &&
             eventId.size() > 0 &&
             eventId.size() <= 128 &&
             eventId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTrafficEvent(data) {
      return data.keys().hasAll(['id', 'dateKey', 'timestamp', 'eventType', 'sessionId', 'deviceType']) &&
             isValidTrafficEventId(data.id) &&
             isValidDateKey(data.dateKey) &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.eventType is string && data.eventType.size() <= 64 &&
             data.sessionId is string && data.sessionId.size() <= 96 &&
             data.deviceType in ['mobile', 'tablet', 'desktop'];
    }

    match /platform_traffic_events/{eventId} {
      allow get: if isSuperAdmin() && isValidTrafficEventId(eventId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidTrafficEventId(eventId) && isValidTrafficEvent(request.resource.data);
      allow delete: if isSuperAdmin() && isValidTrafficEventId(eventId);
    }
  }
}
