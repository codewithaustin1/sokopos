rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions: Authentication, Super-Admin & Multi-Tenant Access Control
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'upfrontretaile@gmail.com' ||
        request.auth.uid == 'ulGLrKgcsrWyqcGRJ6DzvHoEYY12' ||
        (request.auth.token.role != null && request.auth.token.role == 'super_admin')
      );
    }

    function tokenBusinessId() {
      return request.auth.token.businessId;
    }

    function isOwnerOf(bizId) {
      return bizId is string &&
             exists(/databases/$(database)/documents/businesses/$(bizId)) &&
             get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerEmail == request.auth.token.email;
    }

    function isMemberOf(bizId) {
      return bizId is string &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == bizId;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        isSuperAdmin()
      );
    }

    function hasTenantAccess(bizId) {
      return isEmailVerified() && (
        isSuperAdmin() ||
        (bizId != null && tokenBusinessId() != null && tokenBusinessId() == bizId) ||
        (bizId != null && isOwnerOf(bizId)) ||
        (bizId != null && isMemberOf(bizId))
      );
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint - Used on app boot to verify network connectivity
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform Settings & Login Branding
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users Collection (Profile documents keyed by Firebase Auth UID)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isEmailVerified() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Businesses Collection (Tenants)
    match /businesses/{businessId} {
      allow get: if true;
      allow list: if true;
      allow create: if isEmailVerified() && (
        isSuperAdmin() ||
        (request.resource.data.ownerEmail != null && request.resource.data.ownerEmail == request.auth.token.email)
      );
      allow update: if isEmailVerified() && (
        isSuperAdmin() ||
        (resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email) ||
        hasTenantAccess(businessId)
      );
      allow delete: if isEmailVerified() && (
        isSuperAdmin() ||
        (resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email)
      );
    }

    // Products Collection (Tenant catalog items - Firestore single source of truth)
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Categories Collection (Tenant product categories)
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Locations Collection (Tenant store branches & till registers)
    match /locations/{locationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Cashiers / Staff Collection (Tenant cashiers & staff accounts)
    match /cashiers/{cashierId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );

      // Private Server-Only Credentials Subcollection:
      match /private/{docId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // Dedicated server-only staff credentials collection
    match /staff_credentials/{credId} {
      allow read, write: if isSuperAdmin();
    }

    // Transactions Collection (Tenant checkout receipts & sales)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Customers Collection (Tenant customer credit & loyalty)
    match /customers/{customerId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Suppliers Collection (Tenant vendor directory & purchasing)
    match /suppliers/{supplierId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Stock Transfers Collection (Inter-branch inventory movements)
    match /stock_transfers/{transferId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Sync Logs Collection (Tenant audit events & replication history)
    match /sync_logs/{syncLogId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }

    // Purged Sales Backups Collection (Tenant pre-reset snapshot archives)
    match /purged_sales_backups/{backupId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.businessId is string && hasTenantAccess(request.resource.data.businessId))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId)) &&
          (!('businessId' in request.resource.data) || !('businessId' in resource.data) || request.resource.data.businessId == resource.data.businessId)
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (!('businessId' in resource.data) || hasTenantAccess(resource.data.businessId))
      );
    }
  }
}
