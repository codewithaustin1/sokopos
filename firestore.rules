rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint - Read-only ping to verify network connectivity
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform Settings & Login Branding (Public read for terminal login screen, write allowed)
    match /platform_settings/{settingId} {
      allow read, write: if true;
    }

    // Businesses collection - Stores & Tenants
    match /businesses/{businessId} {
      allow read, write: if true;
    }

    // Cashiers / Staff collection (Cross-device staff accounts & PIN auth)
    match /cashiers/{cashierId} {
      allow read, write: if true;
    }

    // Products collection (Cross-device catalog & stock sync)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Locations collection (Store branches)
    match /locations/{locationId} {
      allow read, write: if true;
    }

    // Transactions collection (Real-time sales and orders across all terminals)
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Customers collection (Loyalty & Credit tracking)
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Suppliers collection
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Stock Transfers collection
    match /stock_transfers/{transferId} {
      allow read, write: if true;
    }

    // Sync Logs collection
    match /sync_logs/{syncLogId} {
      allow read, write: if true;
    }

    // Purged Sales Backups collection
    match /purged_sales_backups/{backupId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
