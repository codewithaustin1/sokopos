# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and Daraja STK CallBackURL.
APP_URL="MY_APP_URL"

# PAYMENT_PROVIDER: Default processor adapter ('paystack' or 'daraja').
# With hybrid routing enabled, M-Pesa subscription checkouts automatically use Daraja when configured,
# while Card checkouts and POS merchant subaccounts continue using Paystack.
PAYMENT_PROVIDER="paystack"

# PAYSTACK_SECRET_KEY & PAYSTACK_PUBLIC_KEY: Server-side Paystack API credentials.
# Configure your Paystack Test or Live keys in Cloud Run / AI Studio Secrets.
PAYSTACK_SECRET_KEY="MY_PAYSTACK_SECRET_KEY"
PAYSTACK_PUBLIC_KEY="MY_PAYSTACK_PUBLIC_KEY"

# SAFARICOM DARAJA API: M-Pesa Express (STK Push) credentials for subscription checkout.
# Configure real credentials via Cloud Run / AI Studio Secrets (never commit live keys).
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY="MY_DARAJA_CONSUMER_KEY"
DARAJA_CONSUMER_SECRET="MY_DARAJA_CONSUMER_SECRET"
DARAJA_SHORTCODE="174379"
DARAJA_PASSKEY="MY_DARAJA_PASSKEY"
DARAJA_TRANSACTION_TYPE="CustomerPayBillOnline"
DARAJA_CALLBACK_SECRET="MY_DARAJA_CALLBACK_SECRET"
# Optional explicit public HTTPS callback URL override for Daraja STK callbacks
DARAJA_CALLBACK_URL=""

# FIREBASE & FIRESTORE: Database persistence and auth configuration.
FIREBASE_PROJECT_ID="gen-lang-client-0820403611"
FIRESTORE_DATABASE_ID="ai-studio-sokopospointofsa-5314257a-dae6-432a-bde0-81ab935cc7ad"
FIREBASE_WEB_API_KEY="MY_FIREBASE_WEB_API_KEY"
# Service Account JSON (or base64 JSON) with Firestore access for server-side subscription persistence
FIREBASE_SERVICE_ACCOUNT_JSON=""

# DIGITAX API: KRA eTIMS electronic tax invoice fiscalization integration.
DIGITAX_API_KEY="KEN_TEST_api_key_0HBmI6qU0WOhnkjcVgf8cleoFR1yIWsk"

# RESEND & EMAIL OTP: Passwordless 6-digit Email OTP verification delivery.
# Configure RESEND_API_KEY in AI Studio Secrets. Use a verified domain sender in production.
RESEND_API_KEY="MY_RESEND_API_KEY"
RESEND_FROM_EMAIL="SokoPoS <onboarding@resend.dev>"
# Optional server-side HMAC pepper for hashing 6-digit email OTP challenges
EMAIL_OTP_SECRET=""

