            "bluetoothPrinterName": { "type": "string" },
            "printerHeaderNote": { "type": "string" },
            "printerFooterNote": { "type": "string" }
          }
        },
        "brandingSettings": {
          "type": "object",
          "properties": {
            "logoBase64": { "type": "string" },
            "logoFileName": { "type": "string" },
            "aspectRatio": { "type": "string" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "updatedAt": { "type": "string" },
            "updatedBy": { "type": "string" }
          }
        },
        "legalConsent": {
          "type": "object",
          "properties": {
            "termsAccepted": { "type": "boolean" },
            "asIsWarrantyAcknowledged": { "type": "boolean" },
            "operationalRisksAccepted": { "type": "boolean" },
