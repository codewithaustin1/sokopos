    },
    "Category": {
      "title": "Category",
      "description": "Tenant product category scoped by businessId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Point-of-sale receipt transaction scoped to tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "timestamp": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "terminalName": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "syncedToCloud": { "type": "boolean" },
        "totalRefunded": { "type": "number" },
        "etimsData": {
          "type": "object",
          "properties": {
            "saleId": { "type": "string" },
            "traderInvoiceNumber": { "type": "string" },
            "cuSerialNumber": { "type": "string" },
            "cuInvoiceNumber": { "type": "string" },
            "receiptNumber": { "type": "string" },
            "internalData": { "type": "string" },
            "receiptSignature": { "type": "string" },
            "etimsUrl": { "type": "string" },
            "offlineUrl": { "type": "string" },
            "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "FAILED"] },
            "taxPin": { "type": "string" },
            "customerTin": { "type": "string" },
            "attemptCount": { "type": "number" },
            "lastAttemptAt": { "type": "string" },
            "lastError": { "type": "string" }
          }
        },
        "refunds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "refundNumber": { "type": "string" },
              "totalRefund": { "type": "number" },
              "etimsCreditNote": {
                "type": "object",
                "properties": {
                  "creditNoteId": { "type": "string" },
                  "saleId": { "type": "string" },
                  "originalTraderInvoiceNumber": { "type": "string" },
                  "traderInvoiceNumber": { "type": "string" },
                  "cuSerialNumber": { "type": "string" },
                  "cuInvoiceNumber": { "type": "string" },
                  "receiptNumber": { "type": "string" },
                  "receiptSignature": { "type": "string" },
                  "internalData": { "type": "string" },
                  "etimsUrl": { "type": "string" },
                  "offlineUrl": { "type": "string" },
                  "reasonCode": { "type": "string", "enum": ["01", "02", "03", "04", "05", "06"] },
                  "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "FAILED"] },
                  "attemptCount": { "type": "number" },
                  "lastAttemptAt": { "type": "string" },
                  "lastError": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "required": ["id", "businessId", "receiptNumber", "total", "paymentMethod", "status"]
    },
