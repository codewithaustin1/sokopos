{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and business tenant association",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "business_owner", "manager", "cashier", "inventory_clerk"] },
        "businessId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "updatedAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Retail business tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerName": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "currency": { "type": "string" },
        "taxNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "referredByCode": { "type": "string" },
        "referredAt": { "type": "string" },
        "retailTheme": { "type": "string", "enum": ["classic", "emerald", "amber", "burgundy", "industrial"] },
        "hardwareSettings": {
          "type": "object",
          "properties": {
            "autoPrintReceipt": { "type": "boolean" },
            "receiptFormat": { "type": "string", "enum": ["80mm", "58mm", "standard"] },
            "printerType": { "type": "string", "enum": ["system", "bluetooth"] },
            "bluetoothPrinterId": { "type": "string" },
            "bluetoothPrinterName": { "type": "string" },
            "printerHeaderNote": { "type": "string" },
            "printerFooterNote": { "type": "string" }
          }
        }
      },
      "required": ["id", "name", "ownerEmail", "currency"]
    },
    "Product": {
      "title": "Product",
      "description": "Tenant catalog product with multi-location stock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "unit": { "type": "string" },
        "taxRate": { "type": "number" },
        "reorderPoint": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "sku", "sellingPrice"]
    },
    "Category": {
      "title": "Category",
      "description": "Tenant product category scoped by businessId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Point-of-sale receipt transaction scoped to tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "timestamp": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "terminalName": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "syncedToCloud": { "type": "boolean" },
        "totalRefunded": { "type": "number" }
      },
      "required": ["id", "businessId", "receiptNumber", "total", "paymentMethod", "status"]
    },
    "Location": {
      "title": "Location",
      "description": "Retail branch store and terminal configuration scoped to tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "taxId": { "type": "string" },
        "currency": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSynced": { "type": "string" },
        "terminalName": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "code", "city"]
    },
    "Cashier": {
      "title": "Cashier",
      "description": "System staff member with role and PIN scoped to tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "initials": { "type": "string" },
        "code": { "type": "string" },
        "username": { "type": "string" },
        "pin": { "type": "string" },
        "role": { "type": "string" },
        "avatarColor": { "type": "string" },
        "shiftStartedAt": { "type": "string" },
        "assignedLocationId": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "code", "pin", "role"]
    },
    "StockTransfer": {
      "title": "StockTransfer",
      "description": "Inter-branch product stock transfer event scoped to tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "timestamp": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "fromLocationId": { "type": "string" },
        "toLocationId": { "type": "string" },
        "quantity": { "type": "number" },
        "initiatedBy": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "businessId", "productId", "quantity", "fromLocationId", "toLocationId"]
    },
    "SyncLog": {
      "title": "SyncLog",
      "description": "Cloud replication audit record scoped to tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "timestamp": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "type": { "type": "string" },
        "recordsAffected": { "type": "number" },
        "status": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "businessId", "timestamp", "type", "status", "details"]
    },
    "PurgedSalesBackup": {
      "title": "PurgedSalesBackup",
      "description": "Pre-purge archive snapshot of test sales before zero-reset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "businessName": { "type": "string" },
        "createdAt": { "type": "string" },
        "purgedByEmail": { "type": "string" },
        "purgedByName": { "type": "string" },
        "purgedByRole": { "type": "string" },
        "transactionCount": { "type": "number" },
        "grossSales": { "type": "number" },
        "totalRefunded": { "type": "number" },
        "netSales": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["id", "businessId", "createdAt", "purgedByEmail", "transactionCount", "grossSales"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform configurations including login page background graphics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loginBgGraphic": { "type": "string" },
        "loginBgGraphicName": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Tenant customer profile with loyalty points, store credit balance and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "loyaltyPoints": { "type": "number" },
        "storeCreditBalance": { "type": "number" },
        "creditLimit": { "type": "number" },
        "isCreditAllowed": { "type": "boolean" },
        "totalSpent": { "type": "number" },
        "visitCount": { "type": "number" },
        "firstVisitAt": { "type": "string" },
        "lastVisitAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "phone"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Tenant vendor profile with contact details, KRA PIN, payment terms and linked inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "kraPin": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAccount": { "type": "string" },
        "mpesaPaybillOrTill": { "type": "string" },
        "leadTimeDays": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "totalInvoiced": { "type": "number" },
        "ordersCount": { "type": "number" },
        "lastDeliveryDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "phone", "paymentTerms", "status"]
    },
    "Affiliate": {
      "title": "Affiliate",
      "description": "Recurring referral partner profile for store owners and public partners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "accountType": { "type": "string", "enum": ["owner", "public_partner"] },
        "mpesaPhone": { "type": "string" },
        "commissionRate": { "type": "number" },
        "totalEarnedKes": { "type": "number" },
        "availableBalanceKes": { "type": "number" },
        "paidOutKes": { "type": "number" },
        "referralCount": { "type": "number" },
        "activeStoreCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "uid", "email", "name", "code", "accountType", "mpesaPhone", "commissionRate", "status", "createdAt"]
    },
    "AffiliateCommission": {
      "title": "AffiliateCommission",
      "description": "Immutable recurring commission ledger entry tied to a Paystack subscription payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "affiliateId": { "type": "string" },
        "affiliateUid": { "type": "string" },
        "affiliateCode": { "type": "string" },
        "businessId": { "type": "string" },
        "businessName": { "type": "string" },
        "planId": { "type": "string" },
        "paymentReference": { "type": "string" },
        "grossAmountKes": { "type": "number" },
        "commissionRate": { "type": "number" },
        "commissionAmountKes": { "type": "number" },
        "isRenewal": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "reversed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "affiliateId", "affiliateUid", "businessId", "paymentReference", "grossAmountKes", "commissionAmountKes", "status", "createdAt"]
    },
    "AffiliatePayout": {
      "title": "AffiliatePayout",
      "description": "Partner M-Pesa withdrawal request and Super Admin approval record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "affiliateId": { "type": "string" },
        "affiliateUid": { "type": "string" },
        "affiliateCode": { "type": "string" },
        "affiliateName": { "type": "string" },
        "mpesaPhone": { "type": "string" },
        "amountKes": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "rejected"] },
        "mpesaReceiptNumber": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "requestedAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "affiliateId", "affiliateUid", "mpesaPhone", "amountKes", "status", "requestedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Retail tenant records"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Tenant customer profiles and credit directories scoped by businessId"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Tenant vendor directory, terms and linked catalog oversight scoped by businessId"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Tenant catalog products scoped by businessId"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Tenant product categories scoped by businessId"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Tenant POS sales records scoped by businessId"
    },
    "/locations/{locationId}": {
      "schema": "Location",
      "description": "Tenant branch and terminal locations scoped by businessId"
    },
    "/cashiers/{cashierId}": {
      "schema": "Cashier",
      "description": "Tenant cashiers and staff users scoped by businessId"
    },
    "/stock_transfers/{transferId}": {
      "schema": "StockTransfer",
      "description": "Inter-branch stock transfers scoped by businessId"
    },
    "/sync_logs/{syncLogId}": {
      "schema": "SyncLog",
      "description": "Tenant synchronization and audit logs scoped by businessId"
    },
    "/purged_sales_backups/{backupId}": {
      "schema": "PurgedSalesBackup",
      "description": "Tenant test sales archive snapshots preserved prior to clean zero store resets"
    },
    "/platform_settings/{settingId}": {
      "schema": "PlatformSettings",
      "description": "Platform global configuration and custom login screen graphics"
    },
    "/affiliates/{affiliateId}": {
      "schema": "Affiliate",
      "description": "Affiliate partner profiles and commission balances"
    },
    "/affiliate_commissions/{commissionId}": {
      "schema": "AffiliateCommission",
      "description": "Recurring affiliate commission ledger entries"
    },
    "/affiliate_payouts/{payoutId}": {
      "schema": "AffiliatePayout",
      "description": "Affiliate M-Pesa payout requests and Super Admin approvals"
    }
  }
}
