{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and business tenant association",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "business_owner", "manager", "supervisor", "cashier", "inventory_clerk", "accountant", "partner"] },
        "businessId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "updatedAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Retail business tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerName": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "starter", "business", "premium", "professional", "pro", "enterprise"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "subscription": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["active", "expired"] },
            "plan": { "type": "string", "enum": ["free", "starter", "business", "premium"] },
            "planId": { "type": "string" },
            "activatedAt": { "type": "string" },
            "expiresAt": { "type": "string" },
            "lastPaymentReference": { "type": "string" },
            "paymentProvider": { "type": "string" }
          }
        },
        "currency": { "type": "string" },
        "taxNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "referredByCode": { "type": "string" },
        "referredAt": { "type": "string" },
        "paystackSubaccountCode": { "type": "string" },
        "paystackSettlementBank": { "type": "string" },
        "paystackSettlementAccountMask": { "type": "string" },
